{
  "name": "monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{cjs,html,js,ts,jsx,tsx,vue,css,scss,json,md}\"",
    "lint:eslint": "eslint",
    "lint:spellcheck": "cspell lint \"**/*.{cjs,html,js,ts,jsx,tsx,vue,css,scss,json,md}\"",
    "commit": "git-cz",
    "prepare": "husky",
    "precommit": "lint-staged",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@monorepo/config": "workspace:*",
    "@types/node": "^24.10.1",
    "commitizen": "^4.3.1",
    "cspell": "^9.4.0",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  }
