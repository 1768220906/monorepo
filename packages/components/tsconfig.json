{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // 生成声明文件（组件库一定要开启）
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    // 开启 Project References 必需
    "composite": true,
    // 不需要编译 JS，只编译 TS
    "allowJs": false,
    // JSX 编译模式（React 项目需要）
    "jsx": "react-jsx",
    // 支持 JSON 文件
    "resolveJsonModule": true,
    // 组件库一般不需要 DOM 类型，交由使用方决定（你也可以保留）
    // "types": []
    // 确保使用 ES 模块输出（配合打包工具）
    "module": "ESNext",
    // 类型查找逻辑不依赖 Vite/webpack，组件库使用 nodenext 最稳
    "moduleResolution": "nodenext"
  },
  // 组件库只包含 src
  "include": ["src"],
  // 排除最终构建目录
  "exclude": ["dist"]
}
