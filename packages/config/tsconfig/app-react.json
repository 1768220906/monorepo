{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": false,
    "resolveJsonModule": true,
    // 前端 app 的构建由 Vite 负责，tsc 只做类型校验
    "noEmit": true
  }
}
